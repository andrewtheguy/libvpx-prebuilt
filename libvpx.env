# The one place the version lives.
#
# `LIBVPX_COMMIT` is what actually gates the build: source.sh clones the tag, checks out that
# commit detached, and asserts `git rev-parse HEAD` against this value, so a tag moved
# upstream stops the build instead of silently becoming the library everything links against.
# Recompute both when bumping:
#
#   git ls-remote --tags https://github.com/webmproject/libvpx | grep 'v<version>\^{}'
#
# 1.16.0 is the newest release tag; v1.17.0-rc1 exists and is a release candidate.
LIBVPX_VERSION=1.16.0
LIBVPX_COMMIT=1024874c5919305883187e2953de8fcb4c3d7fa6

# A git commit rather than the `SHA256(release tarball)` a pinned C dependency usually carries.
#
# libvpx publishes no tarballs at all — only tags. GitHub will hand you one for a tag, but
# those are generated on demand by `git archive` and carry no stability guarantee: a change in
# how git spells a tar header rewrites the bytes of every one of them, and a committed
# checksum against that URL is a build that breaks for reasons nobody caused. libvpx runs no
# download host of its own to fall back on either.
#
# A commit SHA is a stronger pin than a tarball hash rather than a weaker one: it covers the
# whole tree, git verifies it on checkout, and it cannot be regenerated differently. What it
# does not cover is the *transport* — so the clone is over HTTPS and the assertion is made
# after checkout, against this value, in the one function both scripts use.
LIBVPX_REPO=https://github.com/webmproject/libvpx

# Where the built archives are published. Read by sync-prebuilt.sh and by
# crates/libvpx-prebuilt-sys/build.rs, so that a fork changes this in one place rather than in
# two scripts and a build script.
PREBUILT_REPO=andrewtheguy/libvpx-prebuilt
